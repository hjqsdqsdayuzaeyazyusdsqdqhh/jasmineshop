# ---------------------------------------------------------------------------
# JasmineShop — environment variables
# Copy this file to .env.local. Never commit .env.local.
# ---------------------------------------------------------------------------

# Canonical, public URL of the site (used for metadata, sitemap, canonical).
NEXT_PUBLIC_SITE_URL=https://jasmineshop.ma

# ---------------------------------------------------------------------------
# Supabase — reserved for a later commerce phase. No Supabase package or client is wired yet.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
